
// the goal of this project is purely for practice, not to build a fast compiler or invent a new language
// and because i want to practice my assembly reading skills, what if i just make the keywords using assembly instructions

// byte  = char
// word  = short
// dword = int
// qword = double
// cmp   = if
// ret   = return
// lea   = pointer

byte add()
{
    byte a = 10;
    byte b = 4;
    ret a + b;
}

byte main()
{
    byte a;
    a = ((4 + 5) / 3) * 10;
    ret 0;
}
